	"bisect nearest": {
		"scope": "python",
		"prefix": "_bisect_nearest",
		"body": [
			"from bisect import bisect_left, bisect_right",
			"",
			"",
			"def bisect_nearest(",
			"    nums: list[int], x: int, side: str = \"left\"",
			") -> tuple[int, int] | None:",
			"    \"\"\"指定方向で条件を満たす最も近い要素の位置と値を返す。",
			"",
			"    Args:",
			"        nums: 昇順ソート済みの整数リスト",
			"        x: 探索する値",
			"        side: \"left\"ならxより小さい要素のうち最も右のもの、",
			"              \"right\"ならxより大きい要素のうち最も左のもの",
			"",
			"    Returns:",
			"        (idx, value): 要素のインデックスと値。",
			"                      nums[idx] == valueが成立する。",
			"                      該当要素がなければNone。",
			"",
			"    Note:",
			"        標準bisectは挿入位置を返すが、この関数は実際の",
			"        要素のインデックスを返す。xと等しい値は除外する。",
			"",
			"    Examples:",
			"        nums = [1, 3, 3, 3, 7]",
			"",
			"        bisect_nearest(nums, 5, \"left\")   # (3, 3)",
			"        bisect_nearest(nums, 5, \"right\")  # (4, 7)",
			"        bisect_nearest(nums, 3, \"left\")   # (0, 1)",
			"        bisect_nearest(nums, 3, \"right\")  # (4, 7)",
			"        bisect_nearest(nums, 0, \"left\")   # None",
			"        bisect_nearest(nums, 0, \"right\")  # (0, 1)",
			"        bisect_nearest(nums, 7, \"left\")   # (3, 3)",
			"        bisect_nearest(nums, 7, \"right\")  # None",
			"    \"\"\"",
			"    if side == \"left\":",
			"        idx = bisect_left(nums, x) - 1",
			"    elif side == \"right\":",
			"        idx = bisect_right(nums, x)",
			"    else:",
			"        raise ValueError(f\"Invalid side: {side!r}\")",
			"",
			"    return (idx, nums[idx]) if 0 <= idx < len(nums) else None"
		],
		"description": "指定方向でxと等しい値を除いた最も近い要素のインデックスと値を返す"
	},
